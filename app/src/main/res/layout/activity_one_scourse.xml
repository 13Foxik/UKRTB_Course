<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OneS_Course"
    android:background="@color/backgroundOneS">

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="62dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="#00FFFFFF"
        android:onClick="homeOnClick"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/homeico" />

    <Button
        android:id="@+id/block4"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/onesb4"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.941"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/block2" />

    <Button
        android:id="@+id/block3"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/onesb3"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Block1" />

    <Button
        android:id="@+id/block2"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/onesb2"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.94"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView27" />

    <Button
        android:id="@+id/Block1"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/onesb1"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView27" />

    <ImageView
        android:id="@+id/imageView27"
        android:layout_width="172dp"
        android:layout_height="190dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.49"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.03"
        app:srcCompat="@drawable/onescourse" />

</androidx.constraintlayout.widget.ConstraintLayout>