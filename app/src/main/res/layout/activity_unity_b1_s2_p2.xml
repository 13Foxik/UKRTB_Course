<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UnityB1S1P2"
        android:background="@drawable/icobg">

    <Button
            android:text="Home"
            android:layout_width="80dp"
            android:layout_height="55dp"
            android:id="@+id/button2"
            android:onClick="homeOnClick"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="56dp" />

    <Button
            android:text="NEXT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/nextBtn2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="56dp"
            android:onClick="nextOnClick" />

    <Button
            android:text="Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/nextBtn3"
            android:onClick="backOnClick"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="56dp" />

    <TextView
            android:text="Операции со строками"
            android:layout_width="381dp"
            android:layout_height="60dp"
            android:id="@+id/textView6"
            android:textSize="34sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            app:layout_constraintHorizontal_bias="0.483"
            android:textColor="#FFFFFF" />

    <TextView
            android:text="Вы могли обратить внимание на то что операции так же можно использовать и с типом данных &quot;String&quot; давайте расмотрим это "
            android:layout_width="355dp"
            android:layout_height="97dp"
            android:id="@+id/textView7"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@+id/textView6"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="28dp"
            android:textColor="#FFFFFF" />

    <ImageView
            android:layout_width="303dp"
            android:layout_height="87dp"
            app:srcCompat="@drawable/operationstr1"
            android:id="@+id/imageView3"
            app:layout_constraintTop_toBottomOf="@+id/textView7"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="28dp"
            android:layout_marginStart="28dp" />

    <ImageView
            android:layout_width="171dp"
            android:layout_height="63dp"
            app:srcCompat="@drawable/operationstr2"
            android:id="@+id/imageView6"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/textView8"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="28dp" />

    <TextView
            android:text="Обратите внимание что просто так строковый тип нельзя так просто взять и прибавить к строковому, для этого нужно сначала преобразовать числовой в строковый."
            android:layout_width="361dp"
            android:layout_height="124dp"
            android:id="@+id/textView8"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@+id/imageView3"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="28dp"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF" />
</androidx.constraintlayout.widget.ConstraintLayout>