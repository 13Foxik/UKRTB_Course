<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UnityB1S1P1"
        android:background="@drawable/icobg">

    <TextView
            android:text="Практическая работа"
            android:layout_width="320dp"
            android:layout_height="87dp"
            android:id="@+id/textView3"
            android:textSize="34sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            app:layout_constraintHorizontal_bias="0.515"
            android:textAlignment="center"
            android:textColor="#FFFFFF" />

    <TextView
            android:text="Результат:"
            android:layout_width="159dp"
            android:layout_height="36dp"
            android:id="@+id/textView9"
            android:textSize="24sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="252dp"
            app:layout_constraintHorizontal_bias="0.067"
            android:textAlignment="center"
            android:textColor="#FFFFFF" />

    <TextView
            android:text="Относительно результата программы каково число x?"
            android:layout_width="349dp"
            android:layout_height="65dp"
            android:id="@+id/textView10"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            app:layout_constraintHorizontal_bias="0.4"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/imageView9"
            android:textColor="#FFFFFF" />

    <TextView
            android:text="Ответ: "
            android:layout_width="77dp"
            android:layout_height="34dp"
            android:id="@+id/textView11"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.08"
            android:textAlignment="viewStart"
            app:layout_constraintTop_toBottomOf="@+id/textView10"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF" />

    <Button
            android:text="Ответить"
            android:layout_width="100dp"
            android:layout_height="57dp"
            android:id="@+id/nextBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="156dp"
            android:layout_marginBottom="52dp"
            android:onClick="nextOnClick"
            app:layout_constraintStart_toEndOf="@+id/button3"
            app:layout_constraintHorizontal_bias="1.0" />

    <Button
            android:text="Home"
            android:layout_width="80dp"
            android:layout_height="55dp"
            android:id="@+id/button3"
            android:onClick="homeOnClick"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="52dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="56dp" />

    <ImageView
            android:layout_width="249dp"
            android:layout_height="107dp"
            app:srcCompat="@drawable/pr1"
            android:id="@+id/imageView8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView3"
            android:layout_marginTop="32dp"
            app:layout_constraintHorizontal_bias="0.165" />

    <ImageView
            android:layout_width="246dp"
            android:layout_height="88dp"
            app:srcCompat="@drawable/pr2"
            android:id="@+id/imageView9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView9"
            android:layout_marginTop="16dp"
            app:layout_constraintHorizontal_bias="0.165" />

    <EditText
            android:layout_width="101dp"
            android:layout_height="41dp"
            android:inputType="text"
            android:ems="10"
            app:layout_constraintStart_toEndOf="@+id/textView11"
            android:layout_marginStart="8dp"
            android:layout_marginTop="17dp"
            app:layout_constraintTop_toBottomOf="@+id/textView10"
            android:id="@+id/answerText"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>