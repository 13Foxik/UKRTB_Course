<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".DefaultPage2"
        android:background="@color/background">

    <Button
            android:text="Home"
            android:layout_width="80dp"
            android:layout_height="55dp"
            android:id="@+id/button2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:onClick="homeOnClick" />

    <Button
            android:text="NEXT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/nextBtn2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="56dp"
            android:onClick="nextOnClick" />

    <Button
            android:text="Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/nextBtn3"
            android:onClick="backOnClick"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="56dp" />

    <TextView
            android:text="EXAMPLESTAGE"
            android:layout_width="264dp"
            android:layout_height="48dp"
            android:id="@+id/textView6"
            android:textSize="34sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="60dp"
            app:layout_constraintHorizontal_bias="0.567" />

    <TextView
            android:text="В данном тексте будет описываться смысл темы ее суть, для чего нужна и так далее.В данном тексте будет описываться смысл темы ее суть, для чего нужна и так далее.В данном тексте будет описываться смысл темы ее суть, для чего нужна и так далее.В данном тексте будет описываться смысл темы ее суть, для чего нужна и так далее.В данном тексте будет описываться смысл темы ее суть, для чего нужна и так далее.В данном тексте будет описываться смысл темы ее суть, для чего нужна и так далее."
