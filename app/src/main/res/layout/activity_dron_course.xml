<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Dron_Course"
    android:background="@color/backgroundDron">

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="62dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="#00FFFFFF"
        android:onClick="homeOnClick"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/homeico" />

    <Button
        android:id="@+id/block17"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/dronb3"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/block15" />

    <Button
        android:id="@+id/block18"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/dronb4"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.941"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/block16" />

    <Button
        android:id="@+id/block15"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/dronb1"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView28" />

    <Button
        android:id="@+id/block16"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/dronb2"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.94"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView28" />

    <ImageView
        android:id="@+id/imageView28"
        android:layout_width="172dp"
        android:layout_height="190dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.49"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.03"
        app:srcCompat="@drawable/dron" />

</androidx.constraintlayout.widget.ConstraintLayout>