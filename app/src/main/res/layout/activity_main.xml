<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:background="#B1C2E0">

    <ImageView
            android:layout_width="150dp"
            android:layout_height="165dp"
            android:importantForAutofill="no"
            app:srcCompat="@drawable/icon"
            android:id="@+id/ImageUKRTB"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            tools:ignore="ContentDescription,ImageContrastCheck" />

    <EditText
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:hint="@string/login"
            android:ems="10"
            android:id="@+id/LoginText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ImageUKRTB"
            android:layout_marginTop="48dp"
            android:minHeight="48dp"
            tools:ignore="Autofill,TextFields" />

    <EditText
            android:layout_width="255dp"
            android:layout_height="50dp"
            android:inputType="textPassword"
            android:ems="10"
            android:id="@+id/PasswordText"
            android:hint="@string/password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/LoginText"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            tools:ignore="Autofill,SpeakableTextPresentCheck,TextFields"
            app:layout_constraintHorizontal_bias="0.503" />

    <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/CheckPassword"
            android:button="@drawable/close_eye"
            android:checked="false"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="@+id/PasswordText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.74"
            app:layout_constraintTop_toTopOf="@+id/PasswordText" />

    <ImageButton
            android:layout_width="100dp"
            android:layout_height="60dp"
            android:contentDescription="TODO"
            app:srcCompat="@drawable/signup"
            android:id="@+id/ButtonSignUp"
            android:background="#00FFFFFF"
            android:backgroundTint="#00FFFFFF"
            android:scaleType="fitStart"
            app:layout_constraintEnd_toStartOf="@+id/ButtonReg"
            android:layout_marginTop="31dp"
            app:layout_constraintTop_toBottomOf="@+id/PasswordText"
            tools:ignore="ContentDescription,HardcodedText,SpeakableTextPresentCheck,ImageContrastCheck" />

    <ImageButton
            android:layout_width="164dp"
            android:layout_height="60dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/reg"
            android:id="@+id/ButtonReg"
            android:background="#00FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.733"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/PasswordText"
            app:layout_constraintVertical_bias="0.0"
            android:layout_marginTop="30dp"
            tools:ignore="SpeakableTextPresentCheck,ImageContrastCheck" />


</androidx.constraintlayout.widget.ConstraintLayout>