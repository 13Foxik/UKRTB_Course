<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:background="@drawable/bg">

    <ImageView
            android:layout_width="271dp"
            android:layout_height="49dp"
            tools:srcCompat="@drawable/stringwhite"
            android:id="@+id/imageView12"
            app:layout_constraintEnd_toEndOf="@+id/LoginText"
            app:layout_constraintStart_toStartOf="@+id/LoginText"
            app:layout_constraintBottom_toBottomOf="@+id/LoginText"
            android:layout_marginBottom="1dp" />

    <ImageView
            android:layout_width="271dp"
            android:layout_height="49dp"
            android:id="@+id/imageView13"
            app:layout_constraintEnd_toEndOf="@+id/LoginText"
            app:layout_constraintStart_toStartOf="@+id/LoginText"
            app:layout_constraintBottom_toBottomOf="@+id/LoginText"
            android:layout_marginBottom="1dp"
            tools:srcCompat="@drawable/polosa"
            android:background="#00FFFFFF"
            app:srcCompat="@drawable/polosa" />

    <ImageView
            android:layout_width="271dp"
            android:layout_height="49dp"
            tools:srcCompat="@drawable/polosa"
            android:id="@+id/imageView14"
            app:layout_constraintEnd_toEndOf="@+id/PasswordText"
            app:layout_constraintStart_toStartOf="@+id/PasswordText"
            app:layout_constraintBottom_toBottomOf="@+id/PasswordText"
            app:layout_constraintHorizontal_bias="0.375"
            app:srcCompat="@drawable/polosa" />

    <ImageView
            android:layout_width="150dp"
            android:layout_height="165dp"
            android:importantForAutofill="no"
            app:srcCompat="@drawable/icon"
            android:id="@+id/ImageUKRTB"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            tools:ignore="ContentDescription,ImageContrastCheck" />

    <EditText
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:hint="@string/login"
            android:ems="10"
            android:id="@+id/LoginText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ImageUKRTB"
            android:layout_marginTop="48dp"
            android:minHeight="48dp"
            tools:ignore="Autofill,TextFields"
            app:layout_constraintHorizontal_bias="0.516"
            android:backgroundTint="#00FFFFFF" />

    <EditText
            android:layout_width="255dp"
            android:layout_height="50dp"
            android:inputType="textPassword"
            android:ems="10"
            android:id="@+id/PasswordText"
            android:hint="@string/password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/LoginText"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            tools:ignore="Autofill,SpeakableTextPresentCheck,TextFields"
            app:layout_constraintHorizontal_bias="0.503"
            android:backgroundTint="#00FFFFFF" />

    <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/CheckPassword"
            android:button="@drawable/close_eye"
            android:checked="false"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textAlignment="center"
            app:layout_constraintStart_toStartOf="@+id/PasswordText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.74"
            app:layout_constraintTop_toTopOf="@+id/PasswordText" />

    <Button
            android:text="Войти"
            android:layout_width="87dp"
            android:layout_height="51dp"
            android:id="@+id/ButtonSignUp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/PasswordText"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0277AA"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.224" />

    <Button
            android:text="Регистрация"
            android:layout_width="181dp"
            android:layout_height="51dp"
            android:id="@+id/ButtonReg"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/PasswordText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.71"
            android:backgroundTint="#C82631"
            android:textColor="#FFFFFF" />


</androidx.constraintlayout.widget.ConstraintLayout>