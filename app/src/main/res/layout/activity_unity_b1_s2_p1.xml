<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UnityB1S1P1"
        android:background="@color/background">

    <ImageView
            android:layout_width="268dp"
            android:layout_height="136dp"
            app:srcCompat="@drawable/operation1"
            android:id="@+id/imageView2"
            app:layout_constraintTop_toBottomOf="@+id/textView4"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp" />

    <ImageView
            android:layout_width="144dp"
            android:layout_height="25dp"
            app:srcCompat="@drawable/operation2"
            android:id="@+id/imageView4"
            app:layout_constraintTop_toBottomOf="@+id/textView5"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="24dp" />

    <TextView
            android:text="Операции над переменными"
            android:layout_width="251dp"
            android:layout_height="85dp"
            android:id="@+id/textView3"
            android:textSize="34sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"
            android:textAlignment="center"
            app:layout_constraintHorizontal_bias="0.503" />

    <TextView
            android:text="Операции над переменными можно проводить разные, в основном все как в математике, сложения, вычетания, умножения и деления"
            android:layout_width="357dp"
            android:layout_height="99dp"
            android:id="@+id/textView4"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/textView3"
            android:layout_marginStart="24dp" />

    <TextView
            android:text="Результат:"
            android:layout_width="109dp"
            android:layout_height="31dp"
            android:id="@+id/textView5"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@+id/imageView2"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="24dp" />

    <Button
            android:text="->"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/nextBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="56dp"
            android:onClick="nextOnClick" />

    <Button
            android:text="Home"
            android:layout_width="80dp"
            android:layout_height="55dp"
            android:id="@+id/button3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:onClick="homeOnClick" />
</androidx.constraintlayout.widget.ConstraintLayout>