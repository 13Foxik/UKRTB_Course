<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".AdminMenu"
        android:background="@color/background">

    <Button
            android:text="Robot"
            android:layout_width="114dp"
            android:layout_height="65dp"
            android:id="@+id/unityBtn3"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:onClick="OnClickRobot"
            app:layout_constraintTop_toBottomOf="@+id/unityBtn2" />

    <Button
            android:text="Dron"
            android:layout_width="114dp"
            android:layout_height="65dp"
            android:id="@+id/unityBtn4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:onClick="OnClickDron"
            app:layout_constraintTop_toBottomOf="@+id/unityBtn3"
            android:layout_marginTop="4dp" />

    <Button
            android:text="back"
            android:layout_width="76dp"
            android:layout_height="40dp"
            android:id="@+id/on"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:onClick="OnClickBack" />

    <Button
            android:text="Unity"
            android:layout_width="114dp"
            android:layout_height="65dp"
            android:id="@+id/unityBtn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="104dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:onClick="OnClickUnity" />

    <Button
            android:text="1S"
            android:layout_width="114dp"
            android:layout_height="65dp"
            android:id="@+id/unityBtn2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:onClick="OnClick1S"
            app:layout_constraintTop_toBottomOf="@+id/unityBtn" />

    <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/email"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="96dp"
            android:hint="E-mail" />

    <Button
            android:text="find"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/findbtn"
            android:onClick="OnClickFind"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="96dp" />

</androidx.constraintlayout.widget.ConstraintLayout>