<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UnityB1S1P1"
        android:background="@drawable/icobg">

    <ImageView
            android:layout_width="369dp"
            android:layout_height="77dp"
            app:srcCompat="@drawable/peremen"
            android:id="@+id/imageView2"
            app:layout_constraintTop_toBottomOf="@+id/textView4"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp" />

    <TextView
            android:text="Переменные"
            android:layout_width="259dp"
            android:layout_height="47dp"
            android:id="@+id/textView3"
            android:textSize="34sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="56dp"
            app:layout_constraintHorizontal_bias="0.614"
            android:textColor="#FFFFFF" />

    <TextView
            android:text="Переменная в C# — это ячейка памяти с некоторым именем, которая помогает хранить данные и извлекает их при необходимости. Чтобы объявить переменную, необходимо указать её тип и имя"
            android:layout_width="368dp"
            android:layout_height="164dp"
            android:id="@+id/textView4"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/textView3"
            android:layout_marginStart="16dp"
            android:textColor="#FFFFFF" />

    <TextView
            android:text="Обьявляются в C# они именно так"
            android:layout_width="365dp"
            android:layout_height="92dp"
            android:id="@+id/textView5"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/imageView2"
            android:layout_marginStart="16dp"
            android:textColor="#FFFFFF" />

    <Button
            android:text="->"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/nextBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="52dp"
            android:onClick="nextOnClick"
            app:layout_constraintStart_toEndOf="@+id/button3"
            android:layout_marginStart="38dp" />

    <Button
            android:text="Home"
            android:layout_width="80dp"
            android:layout_height="55dp"
            android:id="@+id/button3"
            android:onClick="homeOnClick"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>