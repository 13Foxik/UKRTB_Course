<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UnityB1S1P1"
        android:background="@color/background">

    <TextView
            android:text="Циклы"
            android:layout_width="111dp"
            android:layout_height="44dp"
            android:id="@+id/textView3"
            android:textSize="34sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            app:layout_constraintHorizontal_bias="0.503" />

    <TextView
            android:text="Цикл в программировании — это управляющая конструкция, которая заставляет какой-то блок кода выполняться несколько раз."
            android:layout_width="374dp"
            android:layout_height="105dp"
            android:id="@+id/textView4"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/textView3"
            android:layout_marginStart="16dp" />

    <WebView
            android:layout_width="match_parent"
            android:layout_height="250sp"
            android:id="@+id/WebView"
            app:layout_constraintTop_toBottomOf="@+id/textView4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="48dp"
            app:layout_constraintHorizontal_bias="0.52"
            android:overScrollMode="never" />

    <Button
            android:text="Finishstage"
            android:layout_width="145dp"
            android:layout_height="63dp"
            android:id="@+id/button3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:onClick="homeOnClick"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.922"
            app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>