<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".registration"
        android:background="@color/background">

    <ImageView
            android:layout_width="150dp"
            android:layout_height="165dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/icon"
            android:id="@+id/ImageUKRTB"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            tools:ignore="ImageContrastCheck" />

    <EditText
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:autofillHints=""
            android:hint="@string/fio"
            android:ems="10"
            android:id="@+id/FioText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ImageUKRTB"
            android:layout_marginTop="56dp"
            android:minHeight="48dp"
            app:layout_constraintHorizontal_bias="0.503"
            tools:ignore="TextFields" />

    <EditText
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:hint="@string/login"
            android:ems="10"
            android:id="@+id/LoginTextInReg"
            android:importantForAutofill="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/FioText"
            android:minHeight="48dp"
            app:layout_constraintHorizontal_bias="0.503"
            tools:ignore="TextFields" />

    <EditText
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:hint="@string/password"
            android:ems="10"
            android:id="@+id/PasswordTextInReg"
            android:importantForAutofill="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/LoginTextInReg"
            android:minHeight="48dp"
            app:layout_constraintHorizontal_bias="0.503"
            android:layout_marginTop="4dp"
            tools:ignore="TextFields" />

    <ImageButton
            android:layout_width="164dp"
            android:layout_height="60dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/reg"
            android:id="@+id/RegButton"
            android:background="#00FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.237"
            app:layout_constraintTop_toBottomOf="@+id/PasswordTextInReg"
            tools:ignore="SpeakableTextPresentCheck,ImageContrastCheck" />


</androidx.constraintlayout.widget.ConstraintLayout>