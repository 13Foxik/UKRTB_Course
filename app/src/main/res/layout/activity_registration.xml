<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg"
        tools:context=".registration">


    <ImageView
            android:layout_width="186dp"
            android:layout_height="52dp"
            app:srcCompat="@drawable/polosa"
            android:id="@+id/imageView21"
            app:layout_constraintEnd_toEndOf="@+id/TextBirthday"
            app:layout_constraintStart_toStartOf="@+id/TextBirthday"
            app:layout_constraintBottom_toBottomOf="@+id/TextBirthday"
            app:layout_constraintHorizontal_bias="0.0" />

    <ImageView
            android:layout_width="279dp"
            android:layout_height="53dp"
            app:srcCompat="@drawable/polosa"
            android:id="@+id/imageView19"
            app:layout_constraintStart_toStartOf="@+id/edPassword"
            app:layout_constraintEnd_toEndOf="@+id/edPassword"
            app:layout_constraintTop_toTopOf="@+id/edPassword" />

    <ImageView
            android:layout_width="279dp"
            android:layout_height="53dp"
            app:srcCompat="@drawable/polosa"
            android:id="@+id/imageView20"
            app:layout_constraintEnd_toEndOf="@+id/edSuccsesPassword"
            app:layout_constraintStart_toStartOf="@+id/edSuccsesPassword"
            app:layout_constraintTop_toTopOf="@+id/edSuccsesPassword" />

    <ImageView
            android:layout_width="279dp"
            android:layout_height="53dp"
            app:srcCompat="@drawable/polosa"
            android:id="@+id/imageView18"
            app:layout_constraintStart_toStartOf="@+id/edLogin"
            app:layout_constraintEnd_toEndOf="@+id/edLogin"
            app:layout_constraintTop_toTopOf="@+id/edLogin" />

    <ImageView
            android:layout_width="279dp"
            android:layout_height="53dp"
            app:srcCompat="@drawable/polosa"
            android:id="@+id/imageView16"
            app:layout_constraintEnd_toEndOf="@+id/NickName"
            app:layout_constraintStart_toStartOf="@+id/NickName"
            app:layout_constraintTop_toTopOf="@+id/NickName" />

    <ImageView
            android:id="@+id/ImageUKRTB"
            android:layout_width="150dp"
            android:layout_height="165dp"
            android:layout_marginTop="32dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/icon"
            tools:ignore="ImageContrastCheck" />

    <EditText
            android:id="@+id/NickName"
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:autofillHints=""
            android:ems="10"
            android:hint="@string/nickname"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ImageUKRTB"
            tools:ignore="TextFields"
            android:backgroundTint="#FFFFFF" />

    <EditText
            android:id="@+id/edLogin"
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:ems="10"
            android:hint="@string/login"
            android:importantForAutofill="no"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/NickName"
            tools:ignore="TextFields"
            android:backgroundTint="#00FFFFFF"
            android:layout_marginTop="12dp" />

    <EditText
            android:id="@+id/edPassword"
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:ems="10"
            android:hint="Введите пароль"
            android:importantForAutofill="no"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="TextFields"
            app:layout_constraintTop_toBottomOf="@+id/edLogin"
            android:layout_marginTop="12dp"
            android:backgroundTint="#00FFFFFF" />


    <EditText
            android:id="@+id/edSuccsesPassword"
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:ems="10"
            android:hint="Подтвердите пароль"
            android:importantForAutofill="no"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edPassword"
            tools:ignore="TextFields"
            android:backgroundTint="#00FFFFFF" />

    <Button
            android:layout_width="57dp"
            android:layout_height="48dp"
            android:id="@+id/ButtonBirthday"
            app:layout_constraintStart_toEndOf="@+id/TextBirthday"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/edSuccsesPassword"
            android:onClick="BirthdayOnClick"
            android:layout_marginStart="20dp"
            tools:ignore="SpeakableTextPresentCheck" />

    <TextView
            android:layout_width="182dp"
            android:layout_height="41dp"
            android:id="@+id/TextBirthday"
            android:textSize="20sp"
            android:lineSpacingExtra="8sp"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/edSuccsesPassword"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="68dp"
            android:textColorLink="#FFFFFF"
            android:hint="Дата рождения"
            android:backgroundTint="#00FFFFFF" />

    <Button
            android:text="Back"
            android:layout_width="84dp"
            android:layout_height="42dp"
            android:id="@+id/button10"
            android:onClick="BackOnClick"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <Button
            android:text="Регистрация"
            android:layout_width="159dp"
            android:layout_height="52dp"
            android:id="@+id/RegButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="112dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:backgroundTint="#C82631"
            android:textColor="#000000" />


</androidx.constraintlayout.widget.ConstraintLayout>