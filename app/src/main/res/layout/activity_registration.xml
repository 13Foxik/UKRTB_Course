<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".registration">

    <ImageView
        android:id="@+id/ImageUKRTB"
        android:layout_width="150dp"
        android:layout_height="165dp"
        android:layout_marginTop="32dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icon"
        tools:ignore="ImageContrastCheck" />

    <EditText
        android:id="@+id/NickName"
        android:layout_width="259dp"
        android:layout_height="50dp"
        android:layout_marginTop="28dp"
        android:autofillHints=""
        android:ems="10"
        android:hint="@string/nickname"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ImageUKRTB"
        tools:ignore="TextFields" />

    <EditText
        android:id="@+id/edLogin"
        android:layout_width="259dp"
        android:layout_height="50dp"
        android:ems="10"
        android:hint="@string/login"
        android:importantForAutofill="no"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/NickName"
        tools:ignore="TextFields" />

    <EditText
            android:id="@+id/edPassword"
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:ems="10"
            android:hint="Введите пароль"
            android:importantForAutofill="no"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="TextFields"
            app:layout_constraintTop_toBottomOf="@+id/edLogin"
            android:layout_marginTop="12dp" />

    <EditText
            android:id="@+id/edSuccsesPassword"
            android:layout_width="259dp"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:ems="10"
            android:hint="Подтвердите пароль"
            android:importantForAutofill="no"
            android:minHeight="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.503"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edPassword"
            tools:ignore="TextFields" />


    <ImageButton
        android:id="@+id/RegButton"
        android:layout_width="164dp"
        android:layout_height="60dp"
        android:layout_marginBottom="84dp"
        android:background="#00FFFFFF"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/reg"
        tools:ignore="SpeakableTextPresentCheck,ImageContrastCheck" />

    <Button
            android:layout_width="57dp"
            android:layout_height="48dp"
            android:id="@+id/ButtonBirthday"
            app:layout_constraintStart_toEndOf="@+id/TextBirthday"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/edSuccsesPassword"
            android:onClick="BirthdayOnClick"
            android:layout_marginStart="20dp"
            tools:ignore="SpeakableTextPresentCheck" />

    <TextView
            android:layout_width="182dp"
            android:layout_height="41dp"
            android:id="@+id/TextBirthday"
            android:textSize="20sp"
            android:lineSpacingExtra="8sp"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/edSuccsesPassword"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="76dp"
            android:textColorLink="#FFFFFF"
            android:hint="Дата рождения" />

    <Button
            android:text="Back"
            android:layout_width="84dp"
            android:layout_height="42dp"
            android:id="@+id/button10"
            tools:layout_editor_absoluteY="13dp"
            tools:layout_editor_absoluteX="9dp"
            android:onClick="BackOnClick" />


</androidx.constraintlayout.widget.ConstraintLayout>