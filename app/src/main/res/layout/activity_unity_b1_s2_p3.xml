<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UnityB1S1P3"
        android:background="@drawable/icobg">

    <ImageView
            android:layout_width="341dp"
            android:layout_height="112dp"
            app:srcCompat="@drawable/logoperation1"
            android:id="@+id/imageView5"
            app:layout_constraintTop_toBottomOf="@+id/textView13"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginStart="24dp" />

    <ImageView
            android:layout_width="270dp"
            android:layout_height="105dp"
            app:srcCompat="@drawable/logoperation2"
            android:id="@+id/imageView7"
            app:layout_constraintTop_toBottomOf="@+id/textView13"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="116dp"
            android:layout_marginStart="24dp" />

    <TextView
            android:text="Логические операции"
            android:layout_width="361dp"
            android:layout_height="59dp"
            android:id="@+id/textView12"
            android:textSize="34sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF" />

    <Button
            android:text="FinishStage"
            android:layout_width="133dp"
            android:layout_height="61dp"
            android:id="@+id/button8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:onClick="homeOnClick"
            app:layout_constraintHorizontal_bias="0.501"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="92dp" />

    <TextView
            android:text="Логические операции всегда выдают &quot;нет&quot; - тоесть 0 либо &quot;да&quot; - тоесть 1"
            android:layout_width="354dp"
            android:layout_height="82dp"
            android:id="@+id/textView13"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@+id/textView12"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:textColor="#FFFFFF" />

    <Button
            android:text="back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/button13"
            app:layout_constraintEnd_toStartOf="@+id/button8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.846"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="95dp"
            android:onClick="backOnClick" />
</androidx.constraintlayout.widget.ConstraintLayout>