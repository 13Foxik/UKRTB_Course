<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".UnityCourse"
        android:background="@color/background">

    <Button
            android:text="Home"
            android:layout_width="80dp"
            android:layout_height="55dp"
            android:id="@+id/button9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:onClick="homeOnClick" />

    <TextView
            android:text="Unity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textView"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textSize="48sp"
            app:layout_constraintHorizontal_bias="0.505" />

    <Button
            android:text="Создание своего первого проекта"
            android:layout_width="170dp"
            android:layout_height="160dp"
            android:id="@+id/block4"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="11dp"
            app:layout_constraintTop_toBottomOf="@+id/block2" />

    <Button
            android:text="Работа с объектами"
            android:layout_width="170dp"
            android:layout_height="160dp"
            android:id="@+id/block2"
            android:layout_marginTop="72dp"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="16dp" />

    <Button
            android:text="Основной синтаксис C#"
            android:layout_width="170dp"
            android:layout_height="160dp"
            android:id="@+id/Block1"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="72dp"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            android:layout_marginStart="24dp"
            android:onClick="BlockOneOnClick" />

    <Button
            android:text="логика NPC"
            android:layout_width="170dp"
            android:layout_height="160dp"
            android:id="@+id/button12"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/Block1"
            android:layout_marginStart="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>