<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Robotechnology"
    android:background="@color/backgroundRoboTechnology">

    <Button
        android:id="@+id/block14"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/onesb4"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.941"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/block12" />

    <Button
        android:id="@+id/block13"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/robotechnologyb3"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/block11" />

    <Button
        android:id="@+id/block12"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/robotechnologyb2"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.94"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView26" />

    <Button
        android:id="@+id/block11"
        android:layout_width="170dp"
        android:layout_height="160dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/robotechnologyb1"
        android:onClick="BlockOneOnClick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView26" />

    <ImageView
        android:id="@+id/imageView26"
        android:layout_width="172dp"
        android:layout_height="190dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.49"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.03"
        app:srcCompat="@drawable/robotechnologycourse" />

    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="62dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="#00FFFFFF"
        android:onClick="homeOnClick"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/homeico" />
</androidx.constraintlayout.widget.ConstraintLayout>