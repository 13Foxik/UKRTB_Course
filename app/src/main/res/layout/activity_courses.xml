<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Courses"
        android:background="@color/background">

    <ImageButton
            android:layout_width="184dp"
            android:layout_height="106dp"
            app:srcCompat="@drawable/courseico"
            android:id="@+id/coursebtn2"
            android:backgroundTint="#00FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="48dp"
            tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
            android:layout_width="178dp"
            android:layout_height="97dp"
            app:srcCompat="@drawable/profileico"
            android:id="@+id/profilebtn2"
            android:backgroundTint="#00FFFFFF"
            app:layout_constraintStart_toEndOf="@+id/coursebtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            android:layout_marginBottom="52dp"
            tools:ignore="SpeakableTextPresentCheck"
            android:onClick="profileOnClick" />

    <ImageButton
            android:layout_width="170dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/unitylock"
            android:id="@+id/UnityBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="28dp"
            android:layout_marginStart="16dp"
            tools:ignore="SpeakableTextPresentCheck"
            android:onClick="unityOnClick" />

    <ImageButton
            android:layout_width="170dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/oneslock"
            android:id="@+id/OnesBtn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="16dp"
            tools:ignore="SpeakableTextPresentCheck"
            android:onClick="onesOnClick" />

    <ImageButton
            android:layout_width="170dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/robotlock"
            android:id="@+id/RobotBtn"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            tools:ignore="SpeakableTextPresentCheck"
            app:layout_constraintTop_toBottomOf="@+id/UnityBtn"
            android:layout_marginTop="16dp"
            android:onClick="robotOnClick" />

    <ImageButton
            android:layout_width="170dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/dronslock"
            android:id="@+id/DronsBtn"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="SpeakableTextPresentCheck"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@+id/OnesBtn"
            android:layout_marginTop="16dp"
            android:onClick="dronOnClick" />
</androidx.constraintlayout.widget.ConstraintLayout>