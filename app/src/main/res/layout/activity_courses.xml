<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Courses"
        android:background="@color/background">

    <ImageButton
            android:layout_width="170dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/unity"
            android:id="@+id/UnityBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="28dp"
            android:layout_marginStart="16dp"
            tools:ignore="SpeakableTextPresentCheck"
            android:onClick="BlockBtnOnClock" />

    <ImageButton
            android:layout_width="170dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/ones"
            android:id="@+id/OnesBtn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="16dp"
            tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
            android:layout_width="170dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/robotechnology"
            android:id="@+id/RobotBtn"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            tools:ignore="SpeakableTextPresentCheck"
            app:layout_constraintTop_toBottomOf="@+id/UnityBtn"
            android:layout_marginTop="16dp" />

    <ImageButton
            android:layout_width="170dp"
            android:layout_height="160dp"
            app:srcCompat="@drawable/drons"
            android:id="@+id/DronsBtn"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="SpeakableTextPresentCheck"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@+id/OnesBtn"
            android:layout_marginTop="16dp" />
</androidx.constraintlayout.widget.ConstraintLayout>